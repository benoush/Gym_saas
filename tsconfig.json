{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // baseUrl est déprécié sous TS 6 mais encore fonctionnel ; on neutralise
    // l'erreur TS5101 le temps d'une éventuelle migration vers "paths".
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["es2020", "dom"], //"lib": [ES2022],  
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": false,
    "baseUrl": "./src",
    "paths": {
      "@/": ["./"],
      "@config/": ["config/"],
      "@database/": ["database/"],
      "@modules/": ["modules/"],
      "@middlewares/": ["middlewares/"],
      "@common/": ["common/"],
      "@utils/": ["utils/"]
    }
  },
  "include": ["src/*/"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "esm": true
  }
}